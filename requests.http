@baseUrl = http://localhost:3000
@userId = default-user

### 1. Health Check & Live Metrics
GET {{baseUrl}}/health

### 2. List Registered Agents
GET {{baseUrl}}/v1/agents

### 3. List Available Capabilities (Tools, Skills, and Sub-Agents)
GET {{baseUrl}}/v1/capabilities

### 4. Supervisor Run (Direct Prompt)
POST {{baseUrl}}/v1/agents/supervisor/runs
Content-Type: application/json
x-user-id: {{userId}}

{
  "message": "If bangalore's temperature is lesser than 30 degrees celsius, cowsay its cold outside , if more cowsay its hot outside."
}

### 5. General Assistant Scenario
POST {{baseUrl}}/v1/agents/supervisor/runs
Content-Type: application/json

{
  "message": "Summarize the key points from this conversation."
}

### 6. Agent Delegation Scenario (Sub-Agent Execution)
POST {{baseUrl}}/v1/agents/supervisor/runs
Content-Type: application/json

{
  "message": "Break down a complex task into clear steps and summarize the approach."
}

### 7. Multi-Turn Conversational Session (Turn 1: Ingest Context)
POST {{baseUrl}}/v1/agents/supervisor/runs
Content-Type: application/json

{
  "sessionId": "debug-session-101",
  "message": "My name is Alice, I am a lead engineer working with TypeScript and distributed systems."
}

### 8. Multi-Turn Conversational Session (Turn 2: Context Continuity)
POST {{baseUrl}}/v1/agents/supervisor/runs
Content-Type: application/json

{
  "sessionId": "debug-session-101",
  "message": "What is my name and what do I specialize in?"
}

### 9. List All Sessions
GET {{baseUrl}}/v1/sessions

### 10. List Sessions for an Agent
GET {{baseUrl}}/v1/sessions?agentId=supervisor

### 11. Inspect Session Message History
GET {{baseUrl}}/v1/sessions/debug-session-101

### 12. Long-Term Memory (Store Fact)
POST {{baseUrl}}/v1/memory
Content-Type: application/json
x-user-id: {{userId}}

{
  "fact": "The production database cluster was upgraded to PostgreSQL 16.2 in us-west-2.",
  "tags": ["database", "infrastructure", "production"]
}

### 13. Long-Term Memory (Semantic Search)
POST {{baseUrl}}/v1/memory/search
Content-Type: application/json
x-user-id: {{userId}}

{
  "query": "What version of PostgreSQL are we running in prod?",
  "limit": 3
}

### 14. Agent Run with Semantic Memory Recall Injected
POST {{baseUrl}}/v1/agents/supervisor/runs
Content-Type: application/json
x-user-id: {{userId}}

{
  "message": "What version of PostgreSQL is deployed in production?",
  "enableLongTermMemory": true
}

### 15. Real-Time Token Streaming over Server-Sent Events (SSE)
POST {{baseUrl}}/v1/agents/supervisor/runs
Content-Type: application/json
Accept: text/event-stream

{
  "message": "Explain the advantages of DAG-based orchestration over linear chains in 3 bullet points.",
  "stream": true
}

### 16. List Pending Human-in-the-Loop (HITL) Approvals
GET {{baseUrl}}/v1/approvals

### 17. Inspect an Approval Checkpoint
# Replace the checkpoint ID with an ID returned from the pending approvals request.
GET {{baseUrl}}/v1/checkpoints/replace-with-checkpoint-id

### 18. Approve a Pending Run or Checkpoint
# Replace the ID with a pending checkpoint ID or its run ID. Use either approve or reject.
POST {{baseUrl}}/v1/runs/replace-with-run-or-checkpoint-id/approve
Content-Type: application/json

{
  "reason": "Reviewed and approved."
}

### 19. Reject a Pending Run or Checkpoint
# Replace the ID with a pending checkpoint ID or its run ID. Use either approve or reject.
POST {{baseUrl}}/v1/runs/replace-with-run-or-checkpoint-id/reject
Content-Type: application/json

{
  "reason": "Rejected after review."
}

### 20. Delete Session
DELETE {{baseUrl}}/v1/sessions/debug-session-101

### 21. Travel Planning via Supervisor (Delegates to Travel Planner)
POST {{baseUrl}}/v1/agents/supervisor/runs
Content-Type: application/json
x-user-id: {{userId}}

{
  "message": "I'd like to plan a 5-day trip to Kyoto in November for 2 people with a moderate budget. Can you help me create an itinerary and calculate the estimated costs?"
}

### 22. Direct Travel Planner Run (Itinerary & Budget Estimation)
POST {{baseUrl}}/v1/agents/travel-planner/runs
Content-Type: application/json
x-user-id: {{userId}}

{
  "message": "Plan a 3-day Tokyo trip focusing on cultural attractions, sushi dining, and scenic views with weather advice and an itemized budget."
}

### 23. Destination Research Run (Deep Neighborhood & Climate Analysis)
POST {{baseUrl}}/v1/agents/destination-researcher/runs
Content-Type: application/json
x-user-id: {{userId}}

{
  "message": "Compare Kyoto and Tokyo for travel in late autumn. Detail weather, top sights, and neighborhood recommendations."
}
