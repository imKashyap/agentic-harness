flowchart TD
    ACL["AgentConfigLoader.load()"] --> JSON["agents/{id}/agent.json"]
    JSON --> AC["AgentConfig"]

    ACL --> FP["FilePromptProvider<br/>('./prompts/agents')"]

    AC --> AF["AgentFactory.create(config)"]
    AF --> MC["ModelCatalog.resolve(config.model)<br/>(config/models.yaml)"]
    MC --> LF["LLMFactory.create(resolved model)"]
    LF --> LLM["LLM adapter"]
    AF --> AR["AgentRunner"]
    AF --> AG["Agent"]

    FP --> AG

    AG -->|"run()"| PROMPT["prompts/agents/{id}.md"]

    AG --> REG["AgentRegistry.register(id, agent)"]
