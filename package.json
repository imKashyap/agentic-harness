{
  "name": "agentic-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsx apps/api/server.ts",
    "ui": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "start:server": "tsx apps/api/server.ts",
    "start": "node dist/apps/api/server.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "tsx --test 'src/**/*.test.ts' 'tests/**/*.test.ts'",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.ts' 'apps/**/*.ts' 'tests/**/*.ts' 'docs/**/*.md' 'agents/**/*.json' 'skills/**/*' 'prompts/**/*' 'README.md'",
    "fix": "npm run lint -- --fix && npm run format",
    "verify": "npm run typecheck && npm run test && npm run lint && prettier --check 'src/**/*.ts' 'apps/**/*.ts' 'tests/**/*.ts'",
    "audit": "npm audit --production",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@eslint/json": "^2.0.1",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "inversify": "^8.2.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  }
}
