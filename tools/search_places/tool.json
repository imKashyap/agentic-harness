{
  "id": "tool.search_places",
  "name": "Search Places",
  "description": "Searches for attractions, restaurants, accommodations, and points of interest in a destination city or region.",
  "type": "tool",
  "inputSchema": {
    "type": "object",
    "properties": {
      "location": {
        "type": "string",
        "description": "The destination city, region, or country (e.g. 'Tokyo', 'Kyoto', 'Paris', 'Rome', 'New York')"
      },
      "category": {
        "type": "string",
        "enum": ["attraction", "restaurant", "hotel", "all"],
        "description": "Category of places to search (default: 'all')"
      },
      "query": {
        "type": "string",
        "description": "Specific place name, activity, or cuisine (e.g. 'ramen', 'art museum', 'boutique hotel', 'gardens')"
      },
      "limit": {
        "type": "number",
        "description": "Maximum number of results to return (default: 5)"
      }
    },
    "required": ["location"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "location": { "type": "string", "description": "Resolved search location" },
      "totalFound": { "type": "number", "description": "Total places found matching criteria" },
      "limit": { "type": "number", "description": "Max results limit applied" },
      "category": { "type": "string", "description": "Filter category applied" },
      "places": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string", "description": "Place or attraction name" },
            "category": { "type": "string", "description": "Place category (attraction, restaurant, hotel)" },
            "rating": { "type": "number", "description": "Rating out of 5" },
            "priceLevel": { "type": "string", "description": "Price indicator (e.g. Free, $, $$, $$$$)" },
            "area": { "type": "string", "description": "Neighborhood or district" },
            "summary": { "type": "string", "description": "Brief description of the place" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        "description": "List of matching places and attractions"
      }
    }
  },
  "progressMessage": "Searching places in {location}..."
}
